/*
0 - 600px:      Phone
600 - 900px:    Tablet portrait
900 - 1200px:   Tablet landscape
[1200 - 1800] is where our normal styles apply
1800px + :      Big desktop
$breakpoint arguement choices:
- phone
- tab-port
- tab-land
- big-desktop

Inside media queries 1em is always 16px i.e 1em = 16px at every screen size only inside media queries
*/
*,
*::after,
*::before {
  margin: 0;
  padding: 0;
  box-sizing: inherit;
  font-family: inherit;
}

html {
  font-size: 62.5%;
  scroll-behavior: smooth;
}
@media only screen and (max-width: 75em) {
  html {
    font-size: 59%;
  }
}
@media only screen and (max-width: 56.25em) {
  html {
    font-size: 56%;
  }
}
@media only screen and (min-width: 112.5em) {
  html {
    font-size: 65%;
  }
}

body {
  box-sizing: border-box;
  position: relative;
  line-height: 1.5;
  font-family: sans-serif;
  overflow-x: hidden;
  overflow-y: scroll;
  font-family: "Source Sans Pro", sans-serif;
}

a {
  text-decoration: none;
  color: inherit;
}

li {
  list-style: none;
}

:focus:not(:focus-visible) {
  outline: none;
}

:focus-visible {
  outline: 3px solid #F97316;
  outline-offset: 2px;
}

button {
  border: none;
  cursor: pointer;
}

textarea {
  resize: none;
}

.heading-primary {
  font-size: 6rem;
  text-transform: uppercase;
  letter-spacing: 3px;
  text-align: center;
}
@media only screen and (max-width: 37.5em) {
  .heading-primary {
    font-size: 4.5rem;
  }
}

.heading-sec__mb-bg {
  margin-bottom: 11rem;
}
@media only screen and (max-width: 56.25em) {
  .heading-sec__mb-bg {
    margin-bottom: 8rem;
  }
}
.heading-sec__mb-med {
  margin-bottom: 9rem;
}
@media only screen and (max-width: 56.25em) {
  .heading-sec__mb-med {
    margin-bottom: 8rem;
  }
}
.heading-sec__main {
  display: block;
  font-size: 4rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  letter-spacing: 3px;
  text-align: center;
  margin-bottom: 3.5rem;
  position: relative;
}
.heading-sec__main--lt {
  color: #FFFFFF;
}
.heading-sec__main--lt::after {
  content: "";
  background: #FFFFFF !important;
}
.heading-sec__main::after {
  content: "";
  position: absolute;
  top: calc(100% + 1.5rem);
  height: 5px;
  width: 3rem;
  background: #F97316;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 5px;
}
@media only screen and (max-width: 37.5em) {
  .heading-sec__main::after {
    top: calc(100% + 1.2rem);
  }
}
.heading-sec__sub {
  display: block;
  text-align: center;
  color: #64748B;
  font-size: 2rem;
  font-weight: 500;
  max-width: 80rem;
  margin: auto;
  line-height: 1.6;
}
@media only screen and (max-width: 37.5em) {
  .heading-sec__sub {
    font-size: 1.8rem;
  }
}
.heading-sec__sub--lt {
  color: #CBD5E1;
}

.heading-sm {
  font-size: 2.2rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.main-container {
  max-width: 120rem;
  margin: auto;
  width: 92%;
}

.btn {
  background: #FFFFFF;
  color: #0F172A;
  text-transform: uppercase;
  letter-spacing: 2px;
  display: inline-block;
  font-weight: 700;
  border-radius: 5px;
  box-shadow: 0 5px 15px 0 rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
}
.btn:hover {
  transform: translateY(-3px);
}
.btn--bg {
  padding: 1.5rem 8rem;
  font-size: 2rem;
}
.btn--med {
  padding: 1.5rem 5rem;
  font-size: 1.6rem;
}
.btn--theme {
  background: #F97316;
  color: #FFFFFF;
}
.btn--theme:hover {
  background: #EA580C;
}
.btn--theme-inv {
  color: #F97316;
  background: transparent;
  border: 2px solid #F97316;
  box-shadow: none;
  padding: calc(1.5rem - 2px) calc(5rem - 2px);
}
.btn--theme-inv:hover {
  background: #F97316;
  color: #FFFFFF;
}
.btn--outline {
  padding: 1.5rem 8rem;
  font-size: 2rem;
  background: transparent;
  color: #FFFFFF;
  border: 2px solid #F97316;
  box-shadow: none;
}
.btn--outline:hover {
  background: #F97316;
  color: #FFFFFF;
}

.sec-pad {
  padding: 12rem 0;
}
@media only screen and (max-width: 56.25em) {
  .sec-pad {
    padding: 8rem 0;
  }
}

.text-primary {
  color: #FFFFFF;
  font-size: 2.2rem;
  text-align: center;
  width: 100%;
  line-height: 1.6;
}
@media only screen and (max-width: 37.5em) {
  .text-primary {
    font-size: 2rem;
  }
}

.d-none {
  display: none;
}

.home-hero {
  color: #FFFFFF;
  background: linear-gradient(135deg, #111827, #1F2937);
  min-height: 100vh;
  position: relative;
}
@media only screen and (max-width: 37.5em) {
  .home-hero {
    min-height: unset;
  }
}
.home-hero__socials {
  position: absolute;
  top: 50%;
  left: 0;
  border: 2px solid #374151;
  border-left: 2px solid #374151;
  transform: translateY(-50%);
}
@media only screen and (max-width: 56.25em) {
  .home-hero__socials {
    display: none;
  }
}
.home-hero__social {
  width: 5rem;
}
.home-hero__social-icon-link {
  width: 100%;
  display: block;
  padding: 1.2rem;
  border-bottom: 2px solid #374151;
  transition: background 0.2s ease;
}
.home-hero__social-icon-link:hover {
  background: rgba(249, 115, 22, 0.15);
}
.home-hero__social-icon-link--bd-none {
  border-bottom: 0;
}
.home-hero__social-icon {
  width: 100%;
}
.home-hero__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 120rem;
  width: 92%;
  margin: 0 auto;
  gap: 6rem;
}
@media only screen and (max-width: 75em) {
  .home-hero__content {
    gap: 4rem;
  }
}
@media only screen and (max-width: 56.25em) {
  .home-hero__content {
    flex-direction: column;
    text-align: center;
    padding: 10rem 4rem 6rem;
    gap: 4rem;
  }
}
.home-hero__left {
  display: flex;
  flex-direction: column;
  flex: 0 0 40%;
}
@media only screen and (max-width: 56.25em) {
  .home-hero__left {
    flex: none;
  }
}
.home-hero__photo {
  position: relative;
  z-index: 1;
  width: 100%;
  height: auto;
  object-fit: contain;
  opacity: 0.5;
  border-radius: 5px;
}
@media only screen and (max-width: 56.25em) {
  .home-hero__photo {
    width: 30rem;
  }
}
@media only screen and (max-width: 37.5em) {
  .home-hero__photo {
    width: 22rem;
  }
}
.home-hero__name {
  font-size: 5.5rem;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.1;
  letter-spacing: 2px;
  margin-bottom: 1rem;
}
@media only screen and (max-width: 56.25em) {
  .home-hero__name {
    font-size: 4rem;
  }
}
@media only screen and (max-width: 37.5em) {
  .home-hero__name {
    font-size: 3rem;
  }
}
.home-hero__accent {
  width: 5rem;
  height: 5px;
  background: #F97316;
  margin-bottom: 2rem;
  border-radius: 3px;
}
.home-hero__right {
  flex: 0 0 60%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
@media only screen and (max-width: 56.25em) {
  .home-hero__right {
    flex: none;
    display: block;
  }
}
.home-hero__subtitle {
  font-size: 2.4rem;
  font-weight: 600;
  color: #64748B;
  letter-spacing: 3px;
  text-transform: uppercase;
  margin-bottom: 2rem;
}
@media only screen and (max-width: 37.5em) {
  .home-hero__subtitle {
    font-size: 1.2rem;
  }
}
.home-hero__desc {
  color: #CBD5E1;
  font-size: 2rem;
  line-height: 1.7;
}
@media only screen and (max-width: 37.5em) {
  .home-hero__desc {
    font-size: 1.8rem;
  }
}

.hero-nav {
  display: flex;
  gap: 3rem;
  margin-bottom: 2rem;
  list-style: none;
  padding: 0;
}
.hero-nav__item {
  list-style: none;
}
.hero-nav__link {
  font-size: 1.6rem;
  font-weight: 700;
  color: #FFFFFF;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: color 0.3s;
}
.hero-nav__link:hover {
  color: #F97316;
}
.hero-nav__link--active {
  color: #FFFFFF;
  position: relative;
}
.hero-nav__link--active::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 6px;
  background: #F97316;
  border-radius: 50%;
}
.hero-nav__link--active {
  color: #FFFFFF;
  position: relative;
}
.hero-nav__link--active::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 6px;
  background: #F97316;
  border-radius: 50%;
}
@media only screen and (max-width: 56.25em) {
  .hero-nav {
    justify-content: center;
  }
}
@media only screen and (max-width: 37.5em) {
  .hero-nav {
    display: none;
  }
}

.about {
  background: #F8FAFC;
}
.about__content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 10rem;
}
@media only screen and (max-width: 56.25em) {
  .about__content {
    grid-template-columns: 1fr;
    grid-gap: 8rem;
  }
}
.about__content-title {
  font-weight: 700;
  font-size: 2.8rem;
  color: #0F172A;
  margin-bottom: 3rem;
}
@media only screen and (max-width: 37.5em) {
  .about__content-title {
    font-size: 2.4rem;
  }
}
.about__content-details-para {
  font-size: 1.8rem;
  color: #334155;
  max-width: 60rem;
  line-height: 1.7;
  margin-bottom: 1rem;
}
.about__content-details-para--hl {
  font-weight: 700;
  margin: 0 3px;
}
.about__content-details-para:last-child {
  margin-bottom: 4rem;
}

.projects {
  background: #FFFFFF;
}
.projects__row {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  grid-gap: 5rem;
  margin-bottom: 11rem;
}
@media only screen and (max-width: 56.25em) {
  .projects__row {
    grid-template-columns: 1fr;
    grid-gap: 2rem;
    margin-bottom: 8rem;
  }
}
@media only screen and (max-width: 56.25em) {
  .projects__row {
    text-align: center;
  }
}
.projects__row:last-child {
  margin-bottom: 0;
}
.projects__row-img-cont {
  overflow: hidden;
}
.projects__row-img {
  width: 100%;
  display: block;
  object-fit: cover;
}
.projects__row-content {
  padding: 2rem 0;
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: flex-start;
}
@media only screen and (max-width: 56.25em) {
  .projects__row-content {
    align-items: center;
  }
}
.projects__row-content-title {
  font-weight: 700;
  font-size: 2.8rem;
  color: #0F172A;
  margin-bottom: 2rem;
}
@media only screen and (max-width: 37.5em) {
  .projects__row-content-title {
    font-size: 2.4rem;
  }
}
.projects__row-content-desc {
  font-size: 1.8rem;
  color: #64748B;
  max-width: 60rem;
  line-height: 1.7;
  margin-bottom: 3rem;
}
@media only screen and (max-width: 37.5em) {
  .projects__row-content-desc {
    font-size: 1.7rem;
  }
}

.contact {
  background: #111827;
}
.contact__form-container {
  background: #1F2937;
  padding: 4rem;
  max-width: 80rem;
  width: 95%;
  border-radius: 5px;
  margin: 5rem auto 0 auto;
}
@media only screen and (max-width: 37.5em) {
  .contact__form-container {
    padding: 3rem;
  }
}
.contact__form-field {
  margin-bottom: 4rem;
}
@media only screen and (max-width: 37.5em) {
  .contact__form-field {
    margin-bottom: 3rem;
  }
}
.contact__form-label {
  color: #CBD5E1;
  font-size: 1.4rem;
  letter-spacing: 1px;
  font-weight: 700;
  margin-bottom: 1rem;
  display: block;
  text-align: left;
}
.contact__form-input {
  color: #FFFFFF;
  padding: 2rem;
  width: 100%;
  border: 1px solid #374151;
  font-size: 1.6rem;
  letter-spacing: 0px;
  background: transparent;
  border-radius: 5px;
  font-weight: 600;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.contact__form-input:focus {
  outline: none;
  border-color: #F97316;
  box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.12);
}
.contact__form-input::placeholder {
  color: #94A3B8;
  font-weight: 600;
  font-size: 1.6rem;
}
.contact__btn {
  width: 30%;
  padding: 2rem 4rem;
  font-size: 1.6rem;
}
@media only screen and (max-width: 37.5em) {
  .contact__btn {
    width: 100%;
  }
}

.project-cs-hero {
  color: #FFFFFF;
  background: radial-gradient(circle at 80% 40%, rgba(249, 115, 22, 0.12), transparent 35%), linear-gradient(135deg, #111827, #1F2937);
  background-size: cover;
  background-position: center;
  position: relative;
}
@media only screen and (max-width: 37.5em) {
  .project-cs-hero {
    height: unset;
    min-height: unset;
  }
}
.project-cs-hero__content {
  padding: 25rem 0 17rem 0;
  max-width: 90rem;
  width: 92%;
  margin: auto;
}
@media only screen and (max-width: 37.5em) {
  .project-cs-hero__content {
    padding: 19rem 0 13rem 0;
    margin: auto;
    position: static;
    transform: translate(0, 0);
  }
}
.project-cs-hero__info {
  margin: 3rem auto 0 auto;
  max-width: 80rem;
}
.project-cs-hero__cta {
  margin-top: 5rem;
  text-align: center;
}

.project-details {
  background: #FFFFFF;
}
.project-details__content {
  padding: 8rem 0;
  max-width: 90rem;
  margin: auto;
}
.project-details__content-title {
  font-weight: 700;
  font-size: 2.8rem;
  color: #0F172A;
  margin-bottom: 3rem;
}
@media only screen and (max-width: 37.5em) {
  .project-details__content-title {
    font-size: 2.4rem;
  }
}
.project-details__showcase-img-cont {
  width: 100%;
  margin-bottom: 6rem;
}
.project-details__showcase-img {
  width: 100%;
}
.project-details__content-main {
  width: 100%;
  max-width: 70rem;
  margin: auto;
}
.project-details__desc {
  margin: 0 0 7rem 0;
}
.project-details__desc-para {
  font-size: 1.8rem;
  line-height: 1.7;
  color: #334155;
  margin-bottom: 2rem;
}
.project-details__tools-used {
  margin: 0 0 7rem 0;
}
.project-details__tools-used-list {
  display: flex;
  flex-wrap: wrap;
}
.project-details__tools-used-item {
  padding: 1rem 2rem;
  margin-bottom: 1.5rem;
  margin-right: 1.5rem;
  font-size: 1.6rem;
  background: #FFF7ED;
  color: #C2410C;
  border: 1px solid #FFEDD5;
  border-radius: 5px;
  font-weight: 600;
}
.project-details__links {
  margin: 0 0;
}
.project-details__links-btn {
  margin-right: 2rem;
}
@media only screen and (max-width: 37.5em) {
  .project-details__links-btn {
    margin-right: 0;
    width: 70%;
    margin-bottom: 2rem;
    text-align: center;
  }
}
.project-details__links-btn:last-child {
  margin: 0;
}
@media only screen and (max-width: 37.5em) {
  .project-details__links-btn:last-child {
    margin: 0;
  }
}

.header {
  position: relative;
  z-index: 1000;
}
.header__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 5rem;
}
@media only screen and (max-width: 56.25em) {
  .header__content {
    padding: 0 2rem;
  }
}
.header__logo-container {
  display: flex;
  align-items: center;
  cursor: pointer;
  color: #0F172A;
  transition: color 0.3s;
}
.header__logo-container:hover {
  color: #F97316;
}
.header__logo-img-cont {
  width: 5rem;
  height: 5rem;
  border-radius: 50px;
  overflow: hidden;
  margin-right: 1.5rem;
  background: #F97316;
}
@media only screen and (max-width: 56.25em) {
  .header__logo-img-cont {
    width: 4.5rem;
    height: 4.5rem;
    margin-right: 1.2rem;
  }
}
.header__logo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.header__logo-sub {
  font-size: 1.8rem;
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 1px;
}
.header__main {
  margin-left: auto;
}
.header__links {
  display: flex;
}
@media only screen and (max-width: 37.5em) {
  .header__links {
    display: none;
  }
}
.header__link {
  padding: 2.2rem 7rem;
  margin: 2rem;
  display: inline-block;
  font-size: 1.6rem;
  color: #FFFFFF;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 700;
  transition: color 0.3s;
}
.header__link:hover {
  color: #F97316;
}
@media only screen and (max-width: 56.25em) {
  .header__link {
    padding: 3rem 2.5rem;
    font-size: 1.5rem;
  }
}
.header__main-ham-menu-cont {
  display: none;
  width: 3rem;
  padding: 2.2rem 0;
}
@media only screen and (max-width: 37.5em) {
  .header__main-ham-menu-cont {
    display: block;
  }
}
.header__main-ham-menu {
  width: 100%;
}
.header__main-ham-menu-close {
  width: 100%;
}
.header__sm-menu {
  background: linear-gradient(135deg, #111827, #1F2937);
  position: absolute;
  width: 100%;
  top: 100%;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
  box-shadow: 0px 5px 5px 0px rgba(0, 0, 0, 0.1);
  -webkit-box-shadow: 0px 5px 5px 0px rgba(0, 0, 0, 0.1);
  -moz-box-shadow: 0px 5px 5px 0px rgba(0, 0, 0, 0.1);
}
.header__sm-menu--active {
  visibility: hidden;
  opacity: 0;
}
@media only screen and (max-width: 37.5em) {
  .header__sm-menu--active {
    visibility: visible;
    opacity: 1;
  }
}
.header__sm-menu-link a {
  display: block;
  text-decoration: none;
  padding: 2.5rem 3rem;
  font-size: 1.6rem;
  color: #FFFFFF;
  text-align: right;
  border-bottom: 1px solid #374151;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  transition: color 0.3s;
}
.header__sm-menu-link a:hover {
  color: #F97316;
}
.header__sm-menu-link:first-child a {
  border-top: 1px solid #374151;
}
.header__sm-menu-link-last {
  border-bottom: 0;
}

.main-footer {
  background: #0D1117;
  color: #FFFFFF;
}
.main-footer__upper {
  display: flex;
  justify-content: space-between;
  padding: 8rem 0;
}
@media only screen and (max-width: 56.25em) {
  .main-footer__upper {
    padding: 6rem 0;
  }
}
@media only screen and (max-width: 37.5em) {
  .main-footer__upper {
    display: block;
  }
}
.main-footer__row-1 {
  order: 2;
}
@media only screen and (max-width: 56.25em) {
  .main-footer__row-1 {
    margin-bottom: 5rem;
  }
}
.main-footer__row-2 {
  width: 40%;
  order: 1;
  max-width: 50rem;
}
@media only screen and (max-width: 56.25em) {
  .main-footer__row-2 {
    width: 100%;
  }
}
.main-footer__short-desc {
  margin-top: 2rem;
  color: #64748B;
  font-size: 1.5rem;
  line-height: 1.7;
}
.main-footer__social-cont {
  margin-top: 2rem;
}
.main-footer__icon {
  margin-right: 1rem;
  width: 2.5rem;
}
.main-footer__icon--mr-none {
  margin-right: 0;
}
.main-footer__lower {
  padding: 4rem 0;
  border-top: 1px solid #1F2937;
  color: #64748B;
  font-size: 1.2rem;
  text-align: left;
  text-align: center;
}
.main-footer__lower a {
  color: #FFFFFF;
  text-decoration: none;
  font-weight: bold;
  margin-left: 2px;
  transition: color 0.2s ease;
}
.main-footer__lower a:hover {
  color: #F97316;
}
@media only screen and (max-width: 56.25em) {
  .main-footer__lower {
    padding: 3.5rem 0;
  }
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}
.skills__skill {
  padding: 1rem 2rem;
  font-size: 1.6rem;
  background: #FFF7ED;
  color: #C2410C;
  border: 1px solid #FFEDD5;
  border-radius: 5px;
  font-weight: 600;
  transition: all 0.2s ease;
}
.skills__skill:hover {
  background: #F97316;
  color: #FFFFFF;
  border-color: #F97316;
}

.projects__row-img-placeholder,
.project-details__showcase-img-placeholder {
  width: 100%;
  height: 100%;
  min-height: 30rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 8rem;
  border-radius: 5px;
  color: #FFFFFF;
}
@media only screen and (max-width: 37.5em) {
  .projects__row-img-placeholder,
  .project-details__showcase-img-placeholder {
    min-height: 20rem;
    font-size: 6rem;
  }
}

.projects__row-img--landing {
  background: linear-gradient(135deg, #64748B, #334155);
}

.projects__row-img--crud {
  background: linear-gradient(135deg, #0D9488, #111827);
}

.projects__row-img--firebase {
  background: linear-gradient(135deg, #F97316, #EA580C);
}

.contact__form-status {
  margin-top: 2rem;
  font-size: 1.5rem;
  font-weight: 600;
  text-align: left;
}
.contact__form-status--sending {
  color: #64748B;
}
.contact__form-status--success {
  color: #22C55E;
}
.contact__form-status--error {
  color: #EF4444;
}

.services {
  background: #F8FAFC;
}
.services__content {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3rem;
}
@media only screen and (max-width: 75em) {
  .services__content {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media only screen and (max-width: 37.5em) {
  .services__content {
    grid-template-columns: 1fr;
  }
}
.services__card {
  background: #FFFFFF;
  padding: 3rem;
  border: 1px solid #E2E8F0;
  border-radius: 5px;
  text-align: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.services__card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}
.services__card-icon {
  display: block;
  font-size: 3.5rem;
  margin-bottom: 2rem;
}
.services__card-title {
  font-weight: 700;
  font-size: 2rem;
  color: #0F172A;
  margin-bottom: 1rem;
}
.services__card-desc {
  font-size: 1.5rem;
  color: #64748B;
  line-height: 1.6;
}

/*# sourceMappingURL=style.css.map */
